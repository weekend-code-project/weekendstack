# ============================================================================
# RESOURCESPACE - Environment Variables
# ============================================================================

RESOURCESPACE_DBNAME=resourcespace
RESOURCESPACE_DBUSER=resourcespace
RESOURCESPACE_DBPASS=                            # <GENERATE> openssl rand -hex 32
RESOURCESPACE_DB_ROOT_PASSWORD=                  # <GENERATE> openssl rand -hex 32
# Create the first ResourceSpace account manually in the web UI.
# Server
RESOURCESPACE_PORT=8099
