# ============================================================================
# PAPERLESS_NGX - Environment Variables
# ============================================================================
# Paperless-ngx - Document Management System
# ============================================================================

# Create the first Paperless account manually on first start.

# Database
PAPERLESS_DB_NAME=paperless_db
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASS=                               # <GENERATE> openssl rand -hex 32

# Security
PAPERLESS_SECRET_KEY=                            # <GENERATE> openssl rand -hex 64

# Server
PAPERLESS_PORT=8082
PAPERLESS_MEMORY_LIMIT=2g

# File Storage (from global paths)
PAPERLESS_MEDIA_PATH=${FILES_BASE_DIR}/paperless/media
