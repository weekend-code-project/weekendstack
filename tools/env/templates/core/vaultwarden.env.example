# ============================================================================
# VAULTWARDEN - Environment Variables
# ============================================================================

# Vaultwarden does not support headless default-user creation.
# Use the admin token for admin-panel tasks and create accounts manually.
VAULTWARDEN_SIGNUPS_ALLOWED=true                 # Set to false after creating accounts
VAULTWARDEN_ADMIN_TOKEN=                         # <GENERATE> openssl rand -hex 32 (optional admin panel)
