# ============================================================================
# OPEN_WEBUI - Environment Variables
# ============================================================================
# Open WebUI (formerly Ollama WebUI)
# Create the first Open WebUI account manually on first boot
# ============================================================================

# App Configuration
WEBUI_SECRET_KEY=                                # <GENERATE> openssl rand -hex 64
ENABLE_SIGNUP=True
OPENAI_API_BASE_URL=http://localai:8080/v1
OPENAI_API_KEY=sk-local-api-key
OPENWEBUI_PORT=3000
