# ============================================================================
# OPEN_WEBUI - Environment Variables
# ============================================================================
# Open WebUI (formerly Ollama WebUI)
# WeekendStack seeds the initial admin account automatically on first boot
# ============================================================================

# App Configuration
WEBUI_SECRET_KEY=                                # <GENERATE> openssl rand -hex 64
WEBUI_ADMIN_NAME=${DEFAULT_ADMIN_USER}
WEBUI_ADMIN_EMAIL=${DEFAULT_ADMIN_EMAIL}
WEBUI_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD}
ENABLE_SIGNUP=False
OPENAI_API_BASE_URL=http://localai:8080/v1
OPENAI_API_KEY=sk-local-api-key
OPENWEBUI_PORT=3000
