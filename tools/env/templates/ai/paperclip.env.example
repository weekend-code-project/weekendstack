# ============================================================================
# PAPERCLIP - Environment Variables
# ============================================================================
# Paperclip runs its own embedded PostgreSQL and first-run signup flow.
# WeekendStack handles routing and persistence; create the first account in-app.
# ============================================================================

PAPERCLIP_PORT=3100
PAPERCLIP_MEMORY_LIMIT=2g
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_TELEMETRY_DISABLED=1
BETTER_AUTH_SECRET=                                # <GENERATE> openssl rand -hex 64
