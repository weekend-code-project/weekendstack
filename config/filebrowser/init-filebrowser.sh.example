#!/bin/sh
# FileBrowser initialization script.
# Copied to /custom-cont-init.d/99-set-password.sh inside the filebrowser:s6 container.
# Runs once at startup (before the main filebrowser process). When explicit
# credentials are provided, it can initialize or update the admin account.

ADMIN_USER="${FILEBROWSER_ADMIN_USER:-admin}"
ADMIN_PASS="${FILEBROWSER_ADMIN_PASSWORD:-}"
DB="${FB_DATABASE:-/config/filebrowser.db}"
FB="filebrowser"
RUNTIME_OWNER="${FB_RUNTIME_OWNER:-abc:users}"

repair_permissions() {
    chown "$RUNTIME_OWNER" "$(dirname "$DB")" 2>/dev/null || true
    [ -f "$DB" ] && chown "$RUNTIME_OWNER" "$DB" 2>/dev/null || true
    [ -f /config/settings.json ] && chown "$RUNTIME_OWNER" /config/settings.json 2>/dev/null || true
    [ -f "$DB" ] && chmod 664 "$DB" 2>/dev/null || true
}

if [ -z "$ADMIN_PASS" ]; then
    echo "[filebrowser-init] No explicit FileBrowser admin password provided — skipping admin bootstrap"
    exit 0
fi

# If the DB doesn't exist yet, initialize it with the admin user and password.
if [ ! -f "$DB" ]; then
    echo "[filebrowser-init] Initializing FileBrowser DB with admin credentials..."
    $FB config init -d "$DB" 2>/dev/null || true
    $FB users add "$ADMIN_USER" "$ADMIN_PASS" --perm.admin -d "$DB" 2>/dev/null || true
    echo "[filebrowser-init] FileBrowser DB initialized."
else
    # DB already exists — keep the configured admin user in sync with setup.
    echo "[filebrowser-init] Updating admin user..."
    $FB users update "$ADMIN_USER" --password "$ADMIN_PASS" --perm.admin -d "$DB" 2>/dev/null || \
    $FB users update admin --username "$ADMIN_USER" --password "$ADMIN_PASS" --perm.admin -d "$DB" 2>/dev/null || \
    $FB users add "$ADMIN_USER" "$ADMIN_PASS" --perm.admin -d "$DB" 2>/dev/null || \
    echo "[filebrowser-init] Could not update admin user"
fi

repair_permissions
